<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window shown while the process starts. Flutter removes it as soon
         as the engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process is up: the colour behind the Flutter UI while
         it initialises, and behind it thereafter. Fixed white rather than
         `?android:colorBackground`, which follows the system's dark mode and
         shows through as black on a handset set to dark. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
