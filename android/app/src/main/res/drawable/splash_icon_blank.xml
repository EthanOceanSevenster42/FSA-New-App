<?xml version="1.0" encoding="utf-8"?>
<!--
  A fully transparent icon for the Android 12+ system splash screen.

  From API 31 the platform draws its own splash: the launcher icon centred on
  `windowSplashScreenBackground`. There is no flag to turn that off, so the
  only way to a plain screen is to hand it an icon with nothing in it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
