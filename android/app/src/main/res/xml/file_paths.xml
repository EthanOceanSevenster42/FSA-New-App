<?xml version="1.0" encoding="utf-8"?>
<!-- What a downloaded document may be shared from: the phone's Downloads
     folder, which is the only place this app writes files for the inspector
     to keep. -->
<paths>
    <external-path name="downloads" path="Download/" />
    <!-- Where a downloaded app update is kept until the installer has
         read it. The files directory, not the cache: Android reclaims the
         cache when a handset runs short of space, and it was taking the
         APK with it mid-update (Ethan, 2026-10-26). The cache entry stays
         so an update already downloaded by an older build still installs. -->
    <files-path name="updates" path="updates/" />
    <cache-path name="updates-legacy" path="updates/" />
</paths>
