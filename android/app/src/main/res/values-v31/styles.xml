<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12 (API 31) replaced the old `windowBackground` splash with a
      system-drawn one: the launcher icon centred on a coloured plate. That is
      what produced the logo-on-a-dark-background flash before the sign-in
      screen appeared.

      The platform gives no way to disable it, so it is made invisible: a white
      plate matching the app, and a transparent icon. The result is a plain
      white screen that simply becomes the sign-in page.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
