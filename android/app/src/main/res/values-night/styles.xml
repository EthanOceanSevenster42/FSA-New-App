<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately identical to values/styles.xml.

      The app renders light-only, so the launch window must not follow the
      system's dark mode. Inheriting Theme.Black here meant a handset set to
      dark mode opened on a black window and then snapped to the white app.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
